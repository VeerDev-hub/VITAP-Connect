PORT=5000
NODE_ENV=development
# Set to 1 when deployed behind one reverse proxy (Render, Railway, Nginx)
TRUST_PROXY=0
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
JWT_SECRET=replace-with-a-long-random-secret
CHAT_ENCRYPTION_KEY=replace-with-a-separate-chat-secret
NEO4J_URI=neo4j+s://your-aura-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
ADMIN_NAME=VITAP Admin
ADMIN_EMAIL=admin@vitapconnect.local
ADMIN_PASSWORD=Admin@12345
MONGODB_URI=mongodb://127.0.0.1:27017/vitap-connect-chat
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=turn:your-turn-server:3478?transport=udp,turn:your-turn-server:3478?transport=tcp
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password
NEO4J_DATABASE=neo4j

# Optional: Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mail. If SMTP_HOST is set it is used for everything (e.g. Mailpit locally).
# Otherwise OTPs go through GOOGLE_MAIL_WEBHOOK and notifications through Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VITAP Connect <no-reply@example.com>
GOOGLE_MAIL_WEBHOOK=
EMAIL_USER=
EMAIL_PASS=

# Optional: Metered-style TURN credentials endpoint (overrides TURN_URLS)
METERED_TURN_API=

# Optional: load a different env file instead of backend/.env
# ENV_FILE=.env.docker
