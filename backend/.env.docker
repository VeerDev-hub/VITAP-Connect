# ─────────────────────────────────────────────────────────────────────────────
# VITAP Connect — local/offline environment for docker-compose.yml
# Everything here points at the containers in docker-compose.yml.
# These are throwaway local credentials: never reuse them in production.
# Your real backend/.env is NOT used by Docker (it is excluded from the image).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

JWT_SECRET=local-dev-jwt-secret-change-me-0123456789abcdef
CHAT_ENCRYPTION_KEY=local-dev-chat-key-change-me-0123456789abcdef

# Neo4j container (credentials must match NEO4J_AUTH in docker-compose.yml)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=vitap-local-dev
NEO4J_DATABASE=neo4j

# MongoDB container
MONGODB_URI=mongodb://mongo:27017/vitap-connect-chat

# Mail goes to Mailpit — read OTP emails at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=VITAP Connect <no-reply@vitapconnect.local>

# Seeded admin (npm run docker:seed)
ADMIN_NAME=VITAP Admin
ADMIN_EMAIL=admin@vitapconnect.local
ADMIN_PASSWORD=Admin@12345

# WebRTC: calls between tabs on the same machine work without STUN/TURN.
STUN_URLS=stun:stun.l.google.com:19302

# Optional — leave blank offline. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
